{
	"name": "acme/brilliant-wordpress-site",
	"description": "Custom WordPress Site",
	"repositories": [
		{
			"type": "composer",
			"url": "https://wpackagist.org",
			"only": [
				"wpackagist-plugin/*",
				"wpackagist-theme/*"
			]
		},
		{
			"type": "package",
			"package": {
				"type": "wordpress-plugin",
				"name": "myplugins/advanced-custom-fields-pro",
				"version": "6.4.2",
				"dist": {
					"type": "zip",
					"url": "wordpress-plugins/advanced-custom-fields-pro.zip"
				},
				"require": {
					"composer/installers": "*",
					"johnpbloch/wordpress": "*"
				}
			}
		},
		{
			"type": "package",
			"package": {
				"type": "wordpress-plugin",
				"name": "myplugins/woocommerce",
				"version": "9.4.3",
				"dist": {
					"type": "zip",
					"url": "wordpress-plugins/woocommerce.9.4.3.zip"
				},
				"require": {
					"composer/installers": "*",
					"johnpbloch/wordpress": "*"
				}
			}
		}
	],
	"require": {
		"johnpbloch/wordpress": "6.6.2",
		"wpackagist-plugin/svg-support": "2.3.18",
		"myplugins/advanced-custom-fields-pro": "6.4.2",
		"myplugins/woocommerce": "9.4.3"
	},
	"autoload": {
		"psr-0": {
			"Acme": "src/"
		}
	},
	"extra": {
		"wordpress-install-dir": "public/",
		"installer-paths": {
			"public/wp-content/mu-plugins/{$name}/": [
				"type:wordpress-muplugin"
			],
			"public/wp-content/plugins/{$name}/": [
				"type:wordpress-plugin"
			],
			"public/wp-content/themes/{$name}/": [
				"type:wordpress-theme"
			]
		}
	},
	"config": {
		"allow-plugins": {
			"johnpbloch/wordpress-core-installer": true,
			"composer/installers": true
		}
	}
}