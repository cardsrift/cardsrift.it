# Copy this file to .env.deploy and fill in the values.
# .env.deploy is gitignored — NEVER commit real credentials.
#
# Values are loaded with bash `source`: KEEP THEM IN SINGLE QUOTES,
# especially the password — spaces, #, $, ; or () would otherwise
# break parsing or even execute as code.

# Aruba FTP host (from the Aruba panel → Hosting → FTP details)
FTP_HOST='ftp.example.com'
FTP_USER='your-ftp-user'
FTP_PASS='your-ftp-password'

# Absolute path ON THE SERVER to the theme folder.
# On Aruba Linux hosting the webroot is usually /www.yourdomain.ext/
FTP_REMOTE_PATH='/www.example.com/wp-content/themes/cardsrift'

# ftp (plain / opportunistic TLS) or ftps (explicit TLS)
FTP_PROTOCOL='ftp'

# Keep false on Aruba: their shared-hosting TLS certificate does not match
# ftp.<yourdomain> hostnames, and a failed verification would make lftp
# treat the server as unreachable/empty. The connection stays TLS-encrypted
# either way. Set true only if your host's certificate matches FTP_HOST.
FTP_VERIFY_CERT='false'
